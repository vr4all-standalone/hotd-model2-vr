 void sound_sdl::sink_callback(void *userdata, uint8_t *data, int len)
 {
 	stream_info *stream = reinterpret_cast<stream_info *>(userdata);
+	if (stream->m_diagnostics) {
+		uint32_t needed = len / 2 / stream->m_buffer.channels();
+		uint32_t available = stream->m_buffer.available();
+		stream->m_consumed += needed;
+		if (needed > available) stream->m_missing += needed - available;
+	}
 	stream->m_buffer.get((int16_t *)data, len / 2 / stream->m_buffer.channels());
 }
 
